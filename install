#!/bin/bash
# Install the browser picker and make it the default web browser.
#   ./install              install and become the default browser
#   ./install --no-default install only; try it with: browser-picker https://example.com
#
# Run it from the plugin folder that `omarchy plugin add` created, or from any
# other checkout. From another checkout it also copies the plugin into place,
# unless `omarchy plugin add` already manages it there.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd -P)
id=kierangraham.browser-picker
bin=$HOME/.local/bin/browser-picker
plugin=$HOME/.config/omarchy/plugins/$id
desktop=$HOME/.local/share/applications/browser-picker.desktop
state=$HOME/.local/state/browser-picker

install -Dm755 "$here/browser-picker" "$bin"

if [[ $here != "$(cd "$plugin" 2>/dev/null && pwd -P)" ]]; then
  if [[ -d $plugin/.git ]]; then
    echo "Leaving $plugin alone: it is a git checkout. Update it with: omarchy plugin update $id"
  else
    mkdir -p "$plugin"
    cp "$here/manifest.json" "$here/Picker.qml" "$plugin/"
  fi
fi

mkdir -p "$(dirname "$desktop")"
sed "s|^Exec=browser-picker |Exec=$bin |" "$here/browser-picker.desktop" >"$desktop"
update-desktop-database "$(dirname "$desktop")" 2>/dev/null || true

omarchy-shell -q shell rescanPlugins
if ! omarchy plugin list 2>/dev/null | grep -q "^$id  *enabled"; then
  omarchy plugin enable "$id" >/dev/null
fi

if [[ ${1:-} != --no-default ]]; then
  current=$(xdg-settings get default-web-browser)
  if [[ $current != browser-picker.desktop ]]; then
    mkdir -p "$state"
    echo "$current" >"$state/previous-default-browser"
  fi
  xdg-settings set default-web-browser browser-picker.desktop
fi

echo "Installed. Default browser: $(xdg-settings get default-web-browser)"
echo "Choices (change them in ~/.config/browser-picker/profiles.json):"
"$bin" --list | jq -r '.[] | "  \(.key // "-")  \(.label)"'
