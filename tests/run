#!/bin/bash
# Checks the plugin, the choices and make install without touching your
# desktop: HOME is a temporary folder and the desktop commands are stubs.
set -euo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
failures=0

check() {
  local name=$1
  shift
  if "$@"; then
    echo "ok    $name"
  else
    echo "FAIL  $name"
    failures=$((failures + 1))
  fi
}

check "plugin validates" omarchy plugin validate "$repo"
check "the script parses" bash -n "$repo/browser-picker"
check "the versions match" test "$("$repo/browser-picker" --version)" = "browser-picker $(jq -r .version "$repo/manifest.json")"

# Stubs: record what would run instead of running it.
stubs=$tmp/stubs
mkdir -p "$stubs"
cat >"$stubs/systemd-run" <<'EOF'
#!/bin/bash
printf '%s\n' "$@" >"$HOME/launched"
EOF
cat >"$stubs/omarchy-shell" <<'EOF'
#!/bin/bash
[[ ${2:-} == summon ]] && { printf "%s" "${4:-}" >"$HOME/summoned"; echo "${STUB_SHELL_REPLY:-ok}"; }
exit 0
EOF
printf '#!/bin/bash\n' >"$stubs/update-desktop-database"
chmod +x "$stubs"/*

export HOME=$tmp/home XDG_CONFIG_HOME=$tmp/home/.config PATH=$stubs:$PATH
unset BROWSER_PICKER_CONFIG
mkdir -p "$HOME/.config/chromium"
cat >"$HOME/.config/chromium/Local State" <<'EOF'
{"profile": {"profiles_order": ["Default", "Profile 2"],
  "info_cache": {"Default": {"name": "Work"}, "Profile 2": {"name": "Weekend"}}}}
EOF
picker=$repo/browser-picker

check "choices come from Local State" \
  test "$("$picker" --list | jq -c 'map([.id, .key, .profile])')" \
  = '[["work","w","Default"],["weekend",null,"Profile 2"],["private","i",null]]'

"$picker" --open weekend https://example.com
check "--open passes the profile and URL" \
  test "$(tail -3 "$HOME/launched" | paste -sd' ')" \
  = "--no-default-browser-check --profile-directory=Profile 2 https://example.com"

"$picker" --incognito
check "--incognito opens the private choice" test "$(tail -1 "$HOME/launched")" = "--incognito"

mkdir -p "$HOME/.config/browser-picker"
cat >"$HOME/.config/browser-picker/profiles.json" <<'EOF'
{"browser": "/usr/bin/chromium", "choices": [
  {"label": "Personal", "profile": "Profile 1", "icon": "~/personal.svg"},
  {"label": "Private", "profile": "Profile 1", "incognito": true, "key": "i"}]}
EOF
check "profiles.json replaces Local State" \
  test "$("$picker" --list | jq -c 'map([.id, .key, .icon])')" \
  = "[[\"personal\",\"p\",\"$HOME/personal.svg\"],[\"private\",\"i\",null]]"

"$picker" --private
check "--private uses the configured profile" \
  test "$(tail -2 "$HOME/launched" | paste -sd' ')" = "--profile-directory=Profile 1 --incognito"

"$picker" https://example.com/page
check "the picker is summoned with the URL and the command's path" \
  test "$(jq -r '.url, (.options | length), .command' "$HOME/summoned" | paste -sd' ')" \
  = "https://example.com/page 2 $repo/browser-picker"

rm -f "$HOME/launched"
STUB_SHELL_REPLY=busy "$picker" https://example.com/fallback
check "without the shell the link still opens" test "$(tail -1 "$HOME/launched")" = "https://example.com/fallback"
rm "$HOME/.config/browser-picker/profiles.json"

# make install, as a user (PREFIX defaults to ~/.local) and as a package.
make -s -C "$repo" install >/dev/null
check "make install puts the command in ~/.local/bin" test -x "$HOME/.local/bin/browser-picker"
check "the desktop entry runs the installed command" \
  grep -qx "Exec=$HOME/.local/bin/browser-picker %u" "$HOME/.local/share/applications/browser-picker.desktop"
make -s -C "$repo" uninstall >/dev/null
check "make uninstall removes both" \
  test ! -e "$HOME/.local/bin/browser-picker" -a ! -e "$HOME/.local/share/applications/browser-picker.desktop"

pkg=$tmp/pkg
make -s -C "$repo" install DESTDIR="$pkg" PREFIX=/usr >/dev/null
check "make install honours DESTDIR and PREFIX" \
  test "$(cd "$pkg" && find . -type f | sort | paste -sd' ')" \
  = "./usr/bin/browser-picker ./usr/share/applications/browser-picker.desktop"
check "the packaged desktop entry runs /usr/bin/browser-picker" \
  grep -qx "Exec=/usr/bin/browser-picker %u" "$pkg/usr/share/applications/browser-picker.desktop"
check "the desktop entry is valid" desktop-file-validate "$pkg/usr/share/applications/browser-picker.desktop"

((failures == 0)) || { echo "$failures failed"; exit 1; }
echo "All checks passed."
